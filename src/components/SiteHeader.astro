---
import Wordmark from './Wordmark.astro';
import MobileNav from './MobileNav.svelte';
import ExternalIcon from './ExternalIcon.astro';
import { linkAttrs } from '../config/links';
import { routes, type Chrome } from '../i18n/chrome';

interface Props {
	chrome: Chrome;
	/** Path of this page in the other language, if one exists. */
	switchHref?: string;
}
const { chrome: copy, switchHref } = Astro.props;
const here = Astro.url.pathname;
const protocolsHref = copy.lang.startsWith('en') ? routes.protocols.en : routes.protocols.es;

const items = [
	{ label: copy.nav.home, href: '/', lang: copy.lang.startsWith('en') ? 'es' : undefined },
	{ label: copy.nav.meshtastic, ...linkAttrs('meshtastic') },
	{ label: copy.nav.meshcore, ...linkAttrs('meshcore') },
	{
		label: copy.nav.protocols,
		href: protocolsHref,
		'aria-current': here === protocolsHref ? ('page' as const) : undefined,
	},
	{
		label: copy.nav.community,
		href: '/#comunidad',
		lang: copy.lang.startsWith('en') ? 'es' : undefined,
	},
];
const discord = { label: copy.nav.discord, ...linkAttrs('discord') };
const langSwitch = switchHref
	? { label: copy.switchTo.label, href: switchHref, lang: copy.switchTo.lang }
	: undefined;
---

<header class="header">
	<div class="container header__bar">
		<a class="header__brand" href="/" aria-label={copy.a11y.home}>
			<Wordmark />
		</a>

		<nav class="header__nav" aria-label={copy.a11y.primaryNav}>
			<ul>
				{items.map((item) => (
					<li>
						<a {...item}>{item.label}</a>
					</li>
				))}
			</ul>
		</nav>

		{langSwitch && (
			<a
				class="header__lang mono"
				href={langSwitch.href}
				hreflang={langSwitch.lang}
				lang={langSwitch.lang}
				title={copy.switchTo.title}
			>
				{langSwitch.label}
			</a>
		)}

		<a class="btn btn--primary header__cta" {...linkAttrs('discord')}>
			{copy.nav.discord}
			<ExternalIcon />
			<span class="visually-hidden">{copy.a11y.newTab}</span>
		</a>

		<div class="header__mobile">
			<MobileNav
				client:media="(max-width: 47.99rem)"
				items={langSwitch ? [...items, langSwitch] : items}
				cta={discord}
				openLabel={copy.a11y.menuOpen}
				closeLabel={copy.a11y.menuClose}
				newTabLabel={copy.a11y.newTab}
				navLabel={copy.a11y.primaryNav}
			/>
		</div>
	</div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgb(11 13 12 / 0.92);
		border-bottom: 1px solid var(--c-border);
		backdrop-filter: saturate(1.2) blur(8px);
	}

	.header__bar {
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--s-6);
		min-height: 4.25rem;
	}

	.header__brand {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		margin-right: auto;
		text-decoration: none;
		color: var(--c-text);
	}

	.header__nav ul {
		display: flex;
		gap: var(--s-1);
	}

	.header__nav a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: var(--s-3);
		color: var(--c-text-2);
		text-decoration: none;
		font-size: var(--t-sm);
		font-weight: 500;
		border-radius: var(--r-control);
		transition: color 160ms var(--ease-out);
	}

	.header__nav a:hover,
	.header__nav a[aria-current='page'] {
		color: var(--c-text);
	}

	.header__nav a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--c-accent-2);
		text-underline-offset: 6px;
		text-decoration-thickness: 2px;
	}

	.header__lang {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: var(--s-3);
		border: 1px solid var(--c-border);
		border-radius: var(--r-control);
		color: var(--c-text-2);
		text-decoration: none;
		font-size: var(--t-xs);
	}

	.header__lang:hover {
		color: var(--c-text);
		border-color: var(--c-border-strong);
	}

	.header__cta {
		min-height: 44px;
		padding: 0.5rem 1rem;
		font-size: var(--t-sm);
	}

	.header__mobile {
		display: none;
	}

	@media (max-width: 47.99rem) {
		.header__nav,
		.header__lang,
		.header__cta {
			display: none;
		}

		.header__mobile {
			display: block;
		}
	}
</style>
