---
import Wordmark from './Wordmark.astro';
import MobileNav from './MobileNav.svelte';
import ExternalIcon from './ExternalIcon.astro';
import { linkAttrs } from '../config/links';
import type { Dictionary } from '../i18n/es';

interface Props {
	copy: Dictionary;
}
const { copy } = Astro.props;

const items = [
	{ label: copy.nav.home, href: '#inicio' },
	{ label: copy.nav.meshtastic, ...linkAttrs('meshtastic') },
	{ label: copy.nav.meshcore, ...linkAttrs('meshcore') },
	{ label: copy.nav.community, href: '#comunidad' },
];
const discord = { label: copy.nav.discord, ...linkAttrs('discord') };
---

<header class="header">
	<div class="container header__bar">
		<a class="header__brand" href="/" aria-label={copy.a11y.home}>
			<Wordmark />
		</a>

		<nav class="header__nav" aria-label={copy.a11y.primaryNav}>
			<ul>
				{items.map((item) => (
					<li>
						<a {...item}>{item.label}</a>
					</li>
				))}
			</ul>
		</nav>

		<a class="btn btn--primary header__cta" {...linkAttrs('discord')}>
			{copy.nav.discord}
			<ExternalIcon />
			<span class="visually-hidden">{copy.a11y.newTab}</span>
		</a>

		<div class="header__mobile">
			<MobileNav
				client:media="(max-width: 47.99rem)"
				items={items}
				cta={discord}
				openLabel={copy.a11y.menuOpen}
				closeLabel={copy.a11y.menuClose}
				newTabLabel={copy.a11y.newTab}
				navLabel={copy.a11y.primaryNav}
			/>
		</div>
	</div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgb(11 13 12 / 0.92);
		border-bottom: 1px solid var(--c-border);
		backdrop-filter: saturate(1.2) blur(8px);
	}

	.header__bar {
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--s-6);
		min-height: 4.25rem;
	}

	.header__brand {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		margin-right: auto;
		text-decoration: none;
		color: var(--c-text);
	}

	.header__nav ul {
		display: flex;
		gap: var(--s-1);
	}

	.header__nav a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: var(--s-3);
		color: var(--c-text-2);
		text-decoration: none;
		font-size: var(--t-sm);
		font-weight: 500;
		border-radius: var(--r-control);
		transition: color 160ms var(--ease-out);
	}

	.header__nav a:hover {
		color: var(--c-text);
	}

	.header__cta {
		min-height: 44px;
		padding: 0.5rem 1rem;
		font-size: var(--t-sm);
	}

	.header__mobile {
		display: none;
	}

	@media (max-width: 47.99rem) {
		.header__nav,
		.header__cta {
			display: none;
		}

		.header__mobile {
			display: block;
		}
	}
</style>
