---
import { links, linkAttrs } from '../config/links';
import { routes } from '../i18n/chrome';
import type { Dictionary } from '../i18n/es';

interface Props {
	copy: Dictionary;
}
const { copy } = Astro.props;
const p = copy.platforms;

const cards = [
	{ id: 'meshtastic' as const, tone: 'lime', ...p.items.meshtastic },
	{ id: 'meshcore' as const, tone: 'teal', ...p.items.meshcore },
];

// MeshCore motif: a small lattice with one route picked out.
const lattice = [
	[34, 84],
	[92, 36],
	[120, 96],
	[172, 58],
	[216, 104],
	[246, 30],
	[292, 74],
];
const latticeEdges: [number, number][] = [
	[0, 1],
	[0, 2],
	[1, 2],
	[1, 3],
	[2, 3],
	[2, 4],
	[3, 4],
	[3, 5],
	[4, 6],
	[5, 6],
	[3, 6],
];
const routeEdges = new Set(['0-2', '2-3', '3-5', '5-6']);
---

<section id="plataformas" class="section" aria-labelledby="platforms-title">
	<div class="container">
		<header class="section-head">
			<h2 id="platforms-title">{p.title}</h2>
			<p>{p.body}</p>
		</header>

		<div class="cards">
			{cards.map((c) => (
				<article class:list={['card', `card--${c.tone}`]} aria-labelledby={`${c.id}-name`}>
					<div class="card__motif" aria-hidden="true">
						{c.id === 'meshtastic' ? (
							<svg viewBox="0 0 320 128" fill="none">
								<g class="motif-grid">
									{[0, 1, 2, 3].map((i) => (
										<line x1="0" y1={16 + i * 32} x2="320" y2={16 + i * 32} />
									))}
								</g>
								{[28, 52, 76, 100].map((r, i) => (
									<path
										d={`M ${96 + r * Math.cos(-0.9)} ${64 + r * Math.sin(-0.9)} A ${r} ${r} 0 0 1 ${96 + r * Math.cos(0.9)} ${64 + r * Math.sin(0.9)}`}
										class="wave"
										style={`opacity:${1 - i * 0.2}`}
									/>
								))}
								{[28, 52].map((r) => (
									<path
										d={`M ${96 - r * Math.cos(-0.9)} ${64 + r * Math.sin(-0.9)} A ${r} ${r} 0 0 0 ${96 - r * Math.cos(0.9)} ${64 + r * Math.sin(0.9)}`}
										class="wave"
										style="opacity:.35"
									/>
								))}
								<circle cx="96" cy="64" r="9" class="dot-solid" />
								<circle cx="236" cy="40" r="7" class="dot" />
								<circle cx="254" cy="94" r="7" class="dot" />
								<circle cx="294" cy="62" r="7" class="dot" />
							</svg>
						) : (
							<svg viewBox="0 0 320 128" fill="none">
								{latticeEdges.map(([a, b]) => (
									<line
										x1={lattice[a][0]}
										y1={lattice[a][1]}
										x2={lattice[b][0]}
										y2={lattice[b][1]}
										class={routeEdges.has(`${a}-${b}`) ? 'edge edge--route' : 'edge'}
									/>
								))}
								{lattice.map(([x, y], i) => (
									<circle
										cx={x}
										cy={y}
										r={i === 0 || i === 6 ? 8 : 6}
										class={i === 0 || i === 6 ? 'dot-solid' : 'dot'}
									/>
								))}
							</svg>
						)}
					</div>

					<div class="card__body">
						<p class="card__domain mono">{links[c.id].display}</p>
						<h3 id={`${c.id}-name`}>{c.name}</h3>
						<p class="card__category">{c.category}</p>
						<p class="card__text">{c.body}</p>
					</div>

					<a
						class:list={['btn', c.tone === 'lime' ? 'btn--primary' : 'btn--secondary btn--teal']}
						{...linkAttrs(c.id)}
					>
						{c.cta}
					</a>
				</article>
			))}
		</div>

		<div class="note">
			<p>{p.note}</p>
			<a class="note__link" href={routes.protocols.es}>
				{p.compare}
			</a>
		</div>
	</div>
</section>

<style>
	.cards {
		display: grid;
		gap: var(--s-5);
	}

	@media (min-width: 48rem) {
		.cards {
			grid-template-columns: 1fr 1fr;
		}
	}

	.card {
		--tone: var(--c-accent);
		display: flex;
		flex-direction: column;
		gap: var(--s-5);
		padding: var(--s-5);
		background: var(--c-surface);
		border: 1px solid var(--c-border);
		border-top: 2px solid var(--tone);
		border-radius: var(--r-card);
		transition: border-color 200ms var(--ease-out);
	}

	.card--teal {
		--tone: var(--c-accent-2);
	}

	.card:hover,
	.card:focus-within {
		border-color: var(--c-border-strong);
		border-top-color: var(--tone);
	}

	.card__motif {
		margin: calc(var(--s-5) * -1) calc(var(--s-5) * -1) 0;
		padding: var(--s-5);
		border-bottom: 1px solid var(--c-border);
		background: var(--c-bg);
	}

	.card__motif svg {
		width: 100%;
		height: auto;
		aspect-ratio: 320 / 128;
	}

	.motif-grid line {
		stroke: var(--c-border);
		stroke-dasharray: 2 6;
	}

	.wave {
		stroke: var(--tone);
		stroke-width: 2;
		stroke-linecap: round;
	}

	.edge {
		stroke: var(--c-border-strong);
		stroke-width: 1.5;
	}

	.edge--route {
		stroke: var(--tone);
		stroke-width: 2.5;
	}

	.dot {
		fill: var(--c-bg);
		stroke: var(--tone);
		stroke-width: 2.5;
	}

	.dot-solid {
		fill: var(--tone);
	}

	.card__body {
		display: grid;
		gap: var(--s-2);
		flex: 1;
	}

	.card__domain {
		color: var(--tone);
	}

	.card h3 {
		font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem);
		font-weight: 700;
	}

	.card__category {
		color: var(--c-text);
		font-weight: 600;
	}

	.card__text {
		color: var(--c-text-2);
		max-width: 34rem;
		margin-top: var(--s-2);
	}

	.card .btn {
		align-self: flex-start;
	}

	.note__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--c-text);
		font-weight: 600;
		text-decoration-color: var(--c-accent-2);
		text-underline-offset: 4px;
	}

	.note {
		margin-top: var(--s-6);
		max-width: 44rem;
		padding-left: var(--s-4);
		border-left: 2px solid var(--c-border-strong);
		color: var(--c-text-2);
		font-size: var(--t-sm);
	}
</style>
