---
import ExternalIcon from './ExternalIcon.astro';
import { linkAttrs } from '../config/links';
import type { Dictionary } from '../i18n/es';

interface Props {
	copy: Dictionary;
}
const { copy } = Astro.props;
const c = copy.closing;
---

<section class="section closing" aria-labelledby="closing-title">
	<div class="container closing__inner">
		<img
			class="closing__island"
			src="/terrain/puerto-rico.svg"
			width="1544"
			height="537"
			alt=""
			loading="lazy"
			decoding="async"
		/>
		<div class="closing__text">
			<h2 id="closing-title">{c.title}</h2>
			<p>{c.body}</p>
		</div>
		<div class="closing__actions">
			<a class="btn btn--primary" {...linkAttrs('meshtastic')}>
				{c.meshtastic}
			</a>
			<a class="btn btn--secondary btn--teal" {...linkAttrs('meshcore')}>
				{c.meshcore}
			</a>
			<a class="btn btn--secondary" {...linkAttrs('discord')}>
				{c.discord}
				<ExternalIcon />
				<span class="visually-hidden">{copy.a11y.newTab}</span>
			</a>
		</div>
	</div>
</section>

<style>
	.closing__inner {
		position: relative;
		display: grid;
		gap: var(--s-6);
		isolation: isolate;
	}

	.closing__island {
		position: absolute;
		z-index: -1;
		right: var(--gutter);
		bottom: -2rem;
		width: min(46rem, 70%);
		height: auto;
		opacity: 0.35;
		pointer-events: none;
	}

	.closing__text {
		display: grid;
		gap: var(--s-4);
		max-width: 40rem;
	}

	.closing h2 {
		font-size: var(--t-h2);
	}

	.closing p {
		color: var(--c-text-2);
		font-size: var(--t-lg);
		max-width: var(--measure);
	}

	.closing__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
	}

	@media (max-width: 29.99rem) {
		.closing__actions .btn {
			flex: 1 1 100%;
		}

		.closing__island {
			width: 100%;
			right: 0;
			opacity: 0.2;
		}
	}
</style>
