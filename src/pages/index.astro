---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Platforms from '../components/Platforms.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Community from '../components/Community.astro';
import ClosingCta from '../components/ClosingCta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { useCopy } from '../i18n';
import { chrome } from '../i18n/chrome';

const copy = useCopy('es');
---

<Base
	chrome={chrome.es}
	title={copy.meta.title}
	description={copy.meta.description}
	ogImageAlt={copy.meta.ogImageAlt}
>
	<link slot="head" rel="preload" href="/terrain/puerto-rico.svg" as="image" type="image/svg+xml" />
	<SiteHeader chrome={chrome.es} />
	<main id="contenido">
		<Hero copy={copy} />
		<Platforms copy={copy} />
		<HowItWorks copy={copy} />
		<Community copy={copy} />
		<ClosingCta copy={copy} />
	</main>
	<SiteFooter chrome={chrome.es} />
</Base>
